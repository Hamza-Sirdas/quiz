# Veritabanı bağlantısı (PostgreSQL)
# Yerel geliştirme:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable&pgbouncer=true&connection_limit=1"
# Üretim (Render Managed PostgreSQL / Neon / Supabase örneği):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require&connection_limit=10"

# Sunucu çalışma modu ve portu
NODE_ENV="development"
PORT="3001"

# Üretimde izin verilen frontend kaynakları (virgülle ayırın, sondaki '/' olmadan)
# Örnek: CORS_ORIGINS="https://quizora.vercel.app,https://quizora.yourdomain.com"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Öğretmen oturum çerezi ayarları
# Aynı kök alan adında 'lax' kullanın; farklı alan adları arasında (örn. .vercel.app -> .onrender.com) HTTPS üzerinde 'none' gerekir.
COOKIE_SAME_SITE="lax"

# İsteğe bağlı yüklenen görseller klasörü (varsayılan: server/uploads)
# UPLOADS_DIR="/var/data/uploads"

# Şifre sıfırlama bağlantısı ve e-posta gönderimi (isteğe bağlı, Resend HTTP API)
# Yapılandırılmadığında uygulama e-posta gönderiliyormuş gibi davranmaz.
APP_BASE_URL="http://localhost:5173"
# RESEND_API_KEY="re_..."
# EMAIL_FROM="QUIZORA <no-reply@yourdomain.com>"

# Frontend derleme zamanı ortam değişkenleri (Vercel / Vite)
# Aynı kökenden sunmuyorsanız backend URL'sini girin (sondaki '/' olmadan):
# VITE_API_URL="https://quizora-api.onrender.com"
# VITE_SOCKET_URL="https://quizora-api.onrender.com"
VITE_API_URL=""
VITE_SOCKET_URL=""

# Yapay Zekâ Quiz Oluşturma (Google Gemini REST API — YALNIZCA sunucu tarafı; kesinlikle VITE_ öneki vermeyin)
# Google AI Studio üzerinden alınan API anahtarını sunucu .env dosyasına ekleyin:
# GEMINI_API_KEY="AIza..."
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
AI_REQUEST_TIMEOUT_MS="45000"
